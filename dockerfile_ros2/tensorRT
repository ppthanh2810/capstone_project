FROM nvcr.io/nvidia/l4t-base:r32.7.1

ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-lc"]

# Jetson repo for TX2 (t186) + basic build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    gnupg2 ca-certificates curl software-properties-common \
    build-essential cmake git pkg-config \
    libusb-1.0-0-dev libglfw3-dev libgtk-3-dev \
    libssl-dev libgl1-mesa-dev libglu1-mesa-dev \
    python3-pip python3-opencv python3-numpy python3-setuptools python3-dev \
    udev usbutils v4l-utils \
    && curl -fsSL https://repo.download.nvidia.com/jetson/jetson-ota-public.asc | apt-key add - \
    && printf "deb https://repo.download.nvidia.com/jetson/common r32.7 main\n" > /etc/apt/sources.list.d/nvidia-l4t-apt-source.list \
    && printf "deb https://repo.download.nvidia.com/jetson/t186 r32.7 main\n" >> /etc/apt/sources.list.d/nvidia-l4t-apt-source.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
       libcudnn8 \
       libnvinfer8 \
       libnvinfer-plugin8 \
       libnvonnxparsers8 \
       libnvparsers8 \
       libnvinfer-bin \
       python3-libnvinfer \
    && rm -rf /var/lib/apt/lists/*

# librealsense from source for Jetson/L4T container
WORKDIR /opt
RUN git clone --depth=1 https://github.com/IntelRealSense/librealsense.git && \
    cd librealsense && \
    mkdir build && cd build && \
    cmake .. \
      -DCMAKE_BUILD_TYPE=Release \
      -DBUILD_EXAMPLES=false \
      -DBUILD_GRAPHICAL_EXAMPLES=false \
      -DBUILD_PYTHON_BINDINGS=true \
      -DPYTHON_EXECUTABLE=/usr/bin/python3 \
      -DFORCE_RSUSB_BACKEND=ON && \
    make -j"$(nproc)" && \
    make install && \
    ldconfig

WORKDIR /workspace
CMD ["bash"]
