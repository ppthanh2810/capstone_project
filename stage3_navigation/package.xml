<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>stage3_navigation</name>
  <version>0.0.0</version>
  <description>Stage 3: Nav2 global path planning (planner_server + NavFn A*) on Stage 2 map/localization. Planning only, no motion.</description>
  <maintainer email="pphuonthanh0805@gmail.com">thanhpham</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- goal_path_bridge -->
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- planning.launch.py -->
  <!-- include stage2_slam localization/mapping.launch.py (LiDAR, motor/teleop, EKF, AMCL/SLAM, CSM) -->
  <exec_depend>stage2_slam</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_navfn_planner</exec_depend>
  <exec_depend>nav2_costmap_2d</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rviz_default_plugins</exec_depend>
  <!-- nav2_rviz_plugins/ParticleCloud trong rviz/planning.rviz (/particle_cloud của AMCL) -->
  <exec_depend>nav2_rviz_plugins</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
